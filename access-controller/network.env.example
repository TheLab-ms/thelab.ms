# Network and Conway server settings baked into the firmware at build time.
# Copy to network.env, fill in, and source before building:
#
#   source network.env && ./build-ota.sh

export CONWAY_SSID="YourWiFi"              # SSID to connect to
export CONWAY_PASSWORD="your-wifi-password" # WPA2 passphrase
export CONWAY_HOST="192.168.1.10"          # Conway server IPv4
export CONWAY_PORT="8080"                  # Conway server port (default 8080)
