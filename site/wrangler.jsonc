{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "thelab-ms",
	"main": "src/index.js",
	"compatibility_date": "2026-09-11",
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": false
		}
	},
	// Matching assets are served first; everything else reaches the Worker.
	// The kiosk page is gated so it only loads through the LAN edge proxy.
	"assets": {
		"directory": "static",
		"binding": "ASSETS",
		"run_worker_first": ["/kiosk", "/kiosk.html"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "thelab-membership",
			"migrations_dir": "migrations",
			"database_id": "3e4bca68-f6db-4ef5-8e92-c80a38f02aa1"
		}
	],
	// Durable Object history; no classes remain.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Membership",
				"EdgeSync"
			]
		},
		{
			"tag": "v2-wiki",
			"new_sqlite_classes": [
				"Wiki"
			]
		},
		{
			"tag": "v3-remove-wiki",
			"deleted_classes": [
				"Wiki"
			]
		},
		{
			"tag": "v4-remove-edge-sync",
			"deleted_classes": [
				"EdgeSync"
			]
		},
		{
			"tag": "v5-remove-membership",
			"deleted_classes": [
				"Membership"
			]
		}
	],
	"secrets": {
		"required": [
			"AUTH_SECRET",
			"EDGE_JWT_PRIVATE_KEY",
			"TURNSTILE_SECRET_KEY",
			"DISCORD_CLIENT_SECRET",
			"DISCORD_BOT_TOKEN",
			"STRIPE_SECRET_KEY",
			"STRIPE_WEBHOOK_SECRET"
		]
	},
	"vars": {
		"SITE_URL": "https://thelab.ms",
		"EDGE_URL": "https://edgeproxy.thelab.ms",
		"EDGE_LAN_URL": "http://edge.thelab.ms",
		"DISCORD_GUILD_ID": "690314626289631294",
		"DISCORD_ROLE_ID": "1252789548073619458",
		"DISCORD_ADMIN_ROLE_ID": "814154862777335876",
		"DISCORD_CLIENT_ID": "1121532987486523503"
	}
}
